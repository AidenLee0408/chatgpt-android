{
  "expo": {
    "name": "페르소나 허브",
    "slug": "persona-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.personahub.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "민감한 정보를 보거나 바꾸기 전에 본인 확인을 해요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.personahub.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "민감한 정보를 보거나 바꾸기 전에 본인 확인을 해요."
        }
      ],
      "expo-font"
    ],
    "scheme": "personahub",
    "experiments": {
      "typedRoutes": false
    }
  }
}
